{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:distill:context-build-artifact:receipt:v1",
  "title": "Context Is a Build Artifact Pilot Record",
  "description": "Data and receipt structures for an excluded pilot or later final run. This schema makes no provider call. Digest construction and required semantic validation are frozen in receipt-validation.md. Deterministic condition identities exclude ground truth, outcomes, timestamps, latency, usage, cost, provider request IDs, and other execution metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_schema_digest",
    "study_phase",
    "record_stage",
    "run_schedule_digest",
    "case",
    "source_set",
    "perturbation",
    "ground_truth_commitment_digest",
    "ground_truth",
    "custody",
    "compiled_context",
    "question_schema",
    "decision_system",
    "execution_authorization",
    "decision",
    "policy",
    "run_validity",
    "validator",
    "measurement",
    "evidence_hashes",
    "receipt_artifact_hashes",
    "identity_digest",
    "outcome_digest",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "context-build-artifact/receipt/v1"
    },
    "receipt_schema_digest": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of the exact pilot-schema.json bytes used to validate this receipt."
    },
    "study_phase": {
      "enum": [
        "pilot",
        "final"
      ]
    },
    "record_stage": {
      "enum": [
        "runner",
        "analysis"
      ]
    },
    "run_schedule_digest": {
      "$ref": "#/$defs/sha256"
    },
    "case": {
      "$ref": "#/$defs/case"
    },
    "source_set": {
      "$ref": "#/$defs/sourceSet"
    },
    "perturbation": {
      "$ref": "#/$defs/perturbation"
    },
    "ground_truth_commitment_digest": {
      "$ref": "#/$defs/sha256"
    },
    "ground_truth": {
      "oneOf": [
        {
          "$ref": "#/$defs/groundTruth"
        },
        {
          "type": "null"
        }
      ]
    },
    "custody": {
      "$ref": "#/$defs/custody"
    },
    "compiled_context": {
      "$ref": "#/$defs/compiledContext"
    },
    "question_schema": {
      "$ref": "#/$defs/questionSchema"
    },
    "decision_system": {
      "$ref": "#/$defs/decisionSystem"
    },
    "execution_authorization": {
      "oneOf": [
        {
          "$ref": "#/$defs/executionAuthorization"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "run_validity": {
      "$ref": "#/$defs/runValidity"
    },
    "validator": {
      "$ref": "#/$defs/validatorIdentity"
    },
    "measurement": {
      "$ref": "#/$defs/measurement"
    },
    "evidence_hashes": {
      "type": "array",
      "minItems": 1,
      "description": "Pre-execution evidence artifacts only. This collection is bound into identity_digest.",
      "items": {
        "$ref": "#/$defs/evidenceHash"
      }
    },
    "receipt_artifact_hashes": {
      "type": "array",
      "description": "Outcome-dependent sanitized response, error, usage, and audit artifacts. This collection is excluded from identity_digest and included in receipt_digest.",
      "items": {
        "$ref": "#/$defs/evidenceHash"
      }
    },
    "identity_digest": {
      "$ref": "#/$defs/sha256",
      "description": "Domain-separated digest of the pre-execution condition projection frozen in receipt-validation.md. It binds execution authorization but excludes ground truth, decision and error outcomes, policy result, run validity, measurement, custody audit metadata, identity_digest, outcome_digest, and receipt_digest."
    },
    "outcome_digest": {
      "$ref": "#/$defs/sha256",
      "description": "Domain-separated digest of the ground-truth, decision, policy-result, and run-validity projection frozen in receipt-validation.md. It excludes measurement metadata."
    },
    "receipt_digest": {
      "$ref": "#/$defs/sha256",
      "description": "Integrity digest of the canonical complete receipt, including measurement metadata but excluding receipt_digest itself. This is not a deterministic experiment identity because timestamps and provider execution metadata are included."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "study_phase": {
            "const": "pilot"
          }
        }
      },
      "then": {
        "properties": {
          "case": {
            "properties": {
              "split": {
                "const": "pilot"
              },
              "repository_role": {
                "const": "pilot_development"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "study_phase": {
            "const": "final"
          }
        }
      },
      "then": {
        "properties": {
          "case": {
            "properties": {
              "split": {
                "enum": [
                  "calibration",
                  "held_out_repository"
                ]
              },
              "repository_role": {
                "enum": [
                  "threshold_development",
                  "safety_calibration",
                  "held_out"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_stage": {
            "const": "runner"
          }
        }
      },
      "then": {
        "properties": {
          "ground_truth": {
            "type": "null"
          },
          "custody": {
            "properties": {
              "unsealed_at": {
                "type": "null"
              },
              "reveal_nonce": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_stage": {
            "const": "analysis"
          }
        }
      },
      "then": {
        "properties": {
          "ground_truth": {
            "$ref": "#/$defs/groundTruth"
          },
          "custody": {
            "properties": {
              "unsealed_at": {
                "type": "string",
                "format": "date-time"
              },
              "reveal_nonce": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "acceptance_score": {
                "type": "null"
              },
              "result": {
                "const": "review"
              },
              "reason_codes": {
                "contains": {
                  "const": "decision_failed"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "status": {
                "const": "not_attempted"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "measurement": {
            "properties": {
              "attempt_count": {
                "const": 0
              },
              "attempt_started_at": {
                "type": "null"
              },
              "attempt_finished_at": {
                "type": "null"
              },
              "latency_ms": {
                "type": "null"
              },
              "rate_limit_waits": {
                "maxItems": 0
              },
              "usage": {
                "type": "null"
              },
              "provider_reported_cost": {
                "type": "null"
              },
              "provider_request_id": {
                "type": "null"
              }
            }
          },
          "policy": {
            "properties": {
              "acceptance_score": {
                "type": "null"
              },
              "result": {
                "const": "review"
              },
              "reason_codes": {
                "contains": {
                  "const": "not_attempted"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "measurement": {
            "properties": {
              "attempt_count": {
                "const": 1
              },
              "attempt_started_at": {
                "type": "string",
                "format": "date-time"
              },
              "attempt_finished_at": {
                "type": "string",
                "format": "date-time"
              },
              "latency_ms": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_system": {
            "properties": {
              "kind": {
                "const": "deterministic_policy"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution_authorization": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "execution_authorization": {
            "$ref": "#/$defs/executionAuthorization"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_system": {
            "properties": {
              "kind": {
                "enum": [
                  "jev_pinned",
                  "frontier_llm_pinned"
                ]
              }
            }
          },
          "decision": {
            "properties": {
              "status": {
                "const": "valid"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "outputs": {
                "items": {
                  "properties": {
                    "probabilities": {
                      "type": "object"
                    },
                    "confidence": {
                      "type": "number"
                    },
                    "confidence_semantics": {
                      "enum": [
                        "selected_label_probability",
                        "provider_defined_versioned"
                      ]
                    }
                  }
                },
                "policy": {
                  "properties": {
                    "acceptance_score": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "repository_url",
        "repository_commit",
        "split",
        "repository_role",
        "task_kind",
        "dataset_snapshot_digest",
        "split_assignment_digest",
        "case_manifest_digest"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "repository_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "repository_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "split": {
          "enum": [
            "pilot",
            "calibration",
            "held_out_repository"
          ]
        },
        "repository_role": {
          "enum": [
            "pilot_development",
            "threshold_development",
            "safety_calibration",
            "held_out"
          ]
        },
        "task_kind": {
          "enum": [
            "evidence_handoff",
            "patch_verification",
            "cleanup_verification",
            "external_effect_verification"
          ]
        },
        "dataset_snapshot_digest": {
          "$ref": "#/$defs/sha256"
        },
        "split_assignment_digest": {
          "$ref": "#/$defs/sha256"
        },
        "case_manifest_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "repository_role": {
                "const": "held_out"
              }
            }
          },
          "then": {
            "properties": {
              "split": {
                "const": "held_out_repository"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "repository_role": {
                  "const": "pilot_development"
                }
              }
            },
            "then": {
              "properties": {
                "split": {
                  "const": "pilot"
                }
              }
            },
            "else": {
              "properties": {
                "split": {
                  "const": "calibration"
                }
              }
            }
          }
        }
      ]
    },
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_set_id",
        "manifest_order",
        "sources",
        "source_set_digest"
      ],
      "properties": {
        "source_set_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "manifest_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "source_set_digest": {
          "$ref": "#/$defs/sha256",
          "description": "Digest of canonical source identities and manifest order; excludes collection timestamps and filesystem metadata."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "relative_path",
        "media_type",
        "byte_length",
        "content_digest",
        "evidence_role"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
        },
        "media_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "content_digest": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_content_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_role": {
          "enum": [
            "required",
            "supporting",
            "contradictory",
            "metadata",
            "irrelevant_control"
          ]
        }
      }
    },
    "perturbation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perturbation_id",
        "type",
        "transform_version",
        "seed",
        "expected_equivalence",
        "base_source_set_digest",
        "result_source_set_digest",
        "transformation_receipt_artifact_id",
        "transformation_receipt_digest"
      ],
      "properties": {
        "perturbation_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "enum": [
            "none",
            "source_reorder",
            "exact_duplicate_insertion",
            "line_ending_change",
            "metadata_noise",
            "path_rename_identical_content",
            "irrelevant_appended_text",
            "one_relevant_fact_change",
            "missing_required_evidence",
            "contradictory_evidence",
            "stale_baseline_or_evidence"
          ]
        },
        "transform_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "expected_equivalence": {
          "enum": [
            "equivalent",
            "meaning_changing"
          ]
        },
        "base_source_set_digest": {
          "$ref": "#/$defs/sha256"
        },
        "result_source_set_digest": {
          "$ref": "#/$defs/sha256"
        },
        "transformation_receipt_artifact_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "transformation_receipt_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "none",
                  "source_reorder",
                  "exact_duplicate_insertion",
                  "line_ending_change",
                  "metadata_noise",
                  "path_rename_identical_content",
                  "irrelevant_appended_text"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "expected_equivalence": {
                "const": "equivalent"
              }
            }
          },
          "else": {
            "properties": {
              "expected_equivalence": {
                "const": "meaning_changing"
              }
            }
          }
        }
      ]
    },
    "groundTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rubric_version",
        "rubric_digest",
        "adjudication_status",
        "answers",
        "adjudication_receipt_digest"
      ],
      "properties": {
        "rubric_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rubric_digest": {
          "$ref": "#/$defs/sha256"
        },
        "adjudication_status": {
          "enum": [
            "agreed",
            "resolved_by_third_adjudicator",
            "contains_indeterminate"
          ]
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/groundTruthAnswer"
          }
        },
        "adjudication_receipt_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "groundTruthAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "label",
        "supporting_evidence_digests"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable",
            "low",
            "medium",
            "high",
            "accept",
            "review",
            "reject",
            "indeterminate"
          ]
        },
        "supporting_evidence_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "disagreement_code": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels_available_to_runner",
        "commitment_published_digest",
        "access_log_digest",
        "unsealed_at",
        "reveal_nonce"
      ],
      "properties": {
        "labels_available_to_runner": {
          "const": false
        },
        "commitment_published_digest": {
          "$ref": "#/$defs/sha256"
        },
        "access_log_digest": {
          "$ref": "#/$defs/sha256"
        },
        "unsealed_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "reveal_nonce": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Custodian-generated 256-bit random nonce, withheld in runner records and revealed only in analysis records."
        }
      }
    },
    "compiledContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "compiler_version",
        "compiler_digest",
        "input_source_set_digest",
        "context_byte_length",
        "compiled_context_digest",
        "artifact_hashes"
      ],
      "properties": {
        "arm": {
          "enum": [
            "raw_deterministic_concatenation",
            "deterministic_lexical_chunk_rank",
            "distill_lock_v0"
          ]
        },
        "compiler_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "compiler_digest": {
          "$ref": "#/$defs/sha256"
        },
        "input_source_set_digest": {
          "$ref": "#/$defs/sha256"
        },
        "context_byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "compiled_context_digest": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceHash"
          }
        }
      }
    },
    "questionSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "question_schema_digest",
        "question_ids"
      ],
      "properties": {
        "schema_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "schema_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "question_schema_digest": {
          "$ref": "#/$defs/sha256"
        },
        "question_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "decisionSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "system_version",
        "system_digest",
        "model",
        "api_version",
        "sdk"
      ],
      "properties": {
        "kind": {
          "enum": [
            "deterministic_policy",
            "jev_pinned",
            "frontier_llm_pinned"
          ]
        },
        "system_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "system_digest": {
          "$ref": "#/$defs/sha256"
        },
        "model": {
          "oneOf": [
            {
              "$ref": "#/$defs/modelIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "api_version": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "sdk": {
          "oneOf": [
            {
              "$ref": "#/$defs/sdkIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "deterministic_policy"
              }
            }
          },
          "then": {
            "properties": {
              "model": {
                "type": "null"
              },
              "api_version": {
                "type": "null"
              },
              "sdk": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "model": {
                "$ref": "#/$defs/modelIdentity"
              },
              "api_version": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "sdk": {
                "$ref": "#/$defs/sdkIdentity"
              }
            }
          }
        }
      ]
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "model_version",
        "model_snapshot_digest",
        "parameters_digest",
        "confidence_semantics_version"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^|[-_/:@.])([Ll][Aa][Tt][Ee][Ss][Tt]|[Ss][Tt][Aa][Bb][Ll][Ee]|[Pp][Rr][Ee][Vv][Ii][Ee][Ww]|[Nn][Ee][Ww][Ee][Ss][Tt])($|[-_/:@.])"
          }
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^|[-_/:@.])([Ll][Aa][Tt][Ee][Ss][Tt]|[Ss][Tt][Aa][Bb][Ll][Ee]|[Pp][Rr][Ee][Vv][Ii][Ee][Ww]|[Nn][Ee][Ww][Ee][Ss][Tt])($|[-_/:@.])"
          }
        },
        "model_snapshot_digest": {
          "$ref": "#/$defs/sha256"
        },
        "parameters_digest": {
          "$ref": "#/$defs/sha256"
        },
        "confidence_semantics_version": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "sdkIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "package_digest"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "package_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executionAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "authorization_record_digest",
        "publication_independence_digest",
        "credential_policy_digest",
        "authorized_budget",
        "provider_spend_cap"
      ],
      "properties": {
        "stage": {
          "enum": [
            "excluded_provider_pilot",
            "final"
          ]
        },
        "authorization_record_digest": {
          "$ref": "#/$defs/sha256"
        },
        "publication_independence_digest": {
          "$ref": "#/$defs/sha256"
        },
        "credential_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "authorized_budget": {
          "$ref": "#/$defs/cost"
        },
        "provider_spend_cap": {
          "$ref": "#/$defs/cost"
        }
      }
    },
    "validatorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json_schema_validator",
        "json_schema_validator_version",
        "format_assertion_enabled",
        "validator_config_digest",
        "semantic_validator_version",
        "semantic_validator_digest"
      ],
      "properties": {
        "json_schema_validator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "json_schema_validator_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "format_assertion_enabled": {
          "const": true
        },
        "validator_config_digest": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_validator_version": {
          "const": "context-build-artifact/semantic-validator/v1"
        },
        "semantic_validator_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "outputs",
        "raw_output_digest"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid",
            "failed",
            "not_attempted"
          ]
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/questionOutput"
          }
        },
        "raw_output_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "valid"
              }
            }
          },
          "then": {
            "properties": {
              "outputs": {
                "minItems": 1
              },
              "raw_output_digest": {
                "$ref": "#/$defs/sha256"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "not_attempted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "outputs": {
                "maxItems": 0
              },
              "error": {
                "$ref": "#/$defs/error"
              }
            },
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "questionOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "selected_label",
        "probabilities",
        "confidence",
        "confidence_semantics"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "selected_label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "probabilities": {
          "oneOf": [
            {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "description": "Complete label distribution. The runner additionally validates finite values and sum within 1e-9 of 1."
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence_semantics": {
          "enum": [
            "selected_label_probability",
            "provider_defined_versioned",
            "not_available"
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "policy_digest",
        "threshold_set_digest",
        "acceptance_score",
        "acceptance_score_definition_digest",
        "result",
        "reason_codes"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "policy_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "threshold_set_digest": {
          "$ref": "#/$defs/sha256"
        },
        "acceptance_score": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance_score_definition_digest": {
          "$ref": "#/$defs/sha256"
        },
        "result": {
          "enum": [
            "accept",
            "review",
            "reject"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "runValidity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "invalid"
              }
            }
          },
          "then": {
            "properties": {
              "reason_codes": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "reason_codes": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduled_call_id",
        "schedule_index",
        "replicate_index",
        "attempt_count",
        "retry_count",
        "rate_limit_waits",
        "attempt_started_at",
        "attempt_finished_at",
        "latency_ms",
        "usage",
        "provider_reported_cost",
        "provider_request_id"
      ],
      "properties": {
        "scheduled_call_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "schedule_index": {
          "type": "integer",
          "minimum": 0
        },
        "replicate_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "attempt_count": {
          "enum": [
            0,
            1
          ]
        },
        "retry_count": {
          "const": 0
        },
        "rate_limit_waits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rateLimitWait"
          }
        },
        "attempt_started_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_finished_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_ms": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "oneOf": [
            {
              "$ref": "#/$defs/usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_reported_cost": {
          "oneOf": [
            {
              "$ref": "#/$defs/cost"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_request_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Execution metadata for audit and secondary outcomes. This entire object is excluded from identity_digest but included in receipt_digest."
    },
    "rateLimitWait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "duration_ms",
        "provider_reason_code"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "provider_reason_code": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "provider_usage_json_digest"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "provider_usage_json_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "pricing_version"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "pricing_version": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "code",
        "retry_count",
        "sanitized_error_artifact_id",
        "error_detail_digest"
      ],
      "properties": {
        "stage": {
          "enum": [
            "preflight",
            "scheduler",
            "compile",
            "transport",
            "provider",
            "parse",
            "schema",
            "policy",
            "receipt"
          ]
        },
        "code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "retry_count": {
          "const": 0
        },
        "sanitized_error_artifact_id": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Must identify a receipt_artifact_hashes entry with the same SHA-256 as error_detail_digest; enforced by the pinned semantic validator."
        },
        "error_detail_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidenceHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "media_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
